{
  "name": "file-search",
  "productName": "File Search",
  "version": "1.0.0",
  "description": "Klasörleri dizinler, değişiklikleri izler, belgelerin içinde akıllı arama yapar (Mastertool › Araçlar)",
  "main": "src/main.js",
  "author": "File Search",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:node-indexer": "node -e \"process.env.FSR_NODE=process.execPath;require('child_process').spawn(require('electron'),['.'],{stdio:'inherit',env:process.env})\"",
    "test": "node scripts/ensure-node-abi.js && node scripts/run-tests.js",
    "icon": "node scripts/make-icon.js",
    "sample": "node scripts/sample-data.js",
    "screenshots": "node scripts/screenshots.js",
    "whisper": "node scripts/fetch-whisper.js",
    "rebuild:electron": "electron-builder install-app-deps",
    "dist": "node scripts/fetch-whisper.js && electron-builder --win",
    "dist:portable": "node scripts/fetch-whisper.js && electron-builder --win portable"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "better-sqlite3": "^11.10.0",
    "extract-zip": "^2.0.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "iconv-lite": "^0.6.3",
    "pdfjs-dist": "^4.10.38",
    "snowball-stemmers": "^0.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.mastertool.filesearch",
    "productName": "File Search",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "npmRebuild": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/@napi-rs/**",
      "node_modules/pdfjs-dist/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/bmp-js/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**",
      "node_modules/idb-keyval/**"
    ],
    "extraResources": [
      {
        "from": "vendor/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "File-Search-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "File Search",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": {
      "artifactName": "File-Search-Portable-${version}.exe"
    }
  }
}
